+def result_receipts():
+    with tg.ledger() as c:
+        return [tuple(r) for r in c.execute("select delivery_key,text,status,attempted_at,message_id,error from deliveries "
+                                            "where delivery_key like 'ticket-result:%' order by attempted_at,rowid")]
