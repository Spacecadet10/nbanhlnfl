+    receipts = result_receipts()
+    assert [r[2] for r in receipts] == ['sent', 'failed'] and receipts[1][0] == owed['delivery_key']
+    monkeypatch.setattr(tg.Telegram, 'call', delivered)                        # Telegram works again
