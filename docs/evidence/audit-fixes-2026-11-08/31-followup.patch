+def reject_all(monkeypatch):
+    delivered = tg.Telegram.call
+    def rejected(self, method, payload, **kw): raise tg.DeliveryError('Telegram rejected sendMessage (HTTP 400).')
+    monkeypatch.setattr(tg.Telegram, 'call', rejected)
+    return delivered
