@@ -0,0 +1,68 @@
+// Soccer page wording follows what the API reports (run: npm run test:unit). Live-state audit 2026-11-08: the page said
+// "predictions are not available… no forecasts", "no validated model exists" and "Not refreshed automatically" beside 85
+// recorded live forecasts and an hourly refresh. Four situations must read differently: forecasts recorded, matches still
+// awaiting theirs, a competition with nothing stored, and a source that failed or went stale.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { dataSourceForecastText, emptyCompetition, forecastBanner, importHint, liveLoadProblem, matchForecastNote } from './soccerStatus.ts';
+
+const when = (iso) => `<${iso}>`;
+const forecast = { probabilities: { home: 0.4512, draw: 0.27, away: 0.2788 }, most_likely: 'home', result: null };
+const NEVER = /not available|no forecasts|no validated model|not refreshed automatically/i;
+
+test('recorded forecasts: the banner and the data note say they exist', () => {
+  const b = forecastBanner('recorded', 'UEFA Nations League');
+  assert.equal(b.kind, 'live');
+  assert.match(b.title + ' ' + b.text, /Live soccer forecasts.*90-minute/);
+  assert.doesNotMatch(b.title + ' ' + b.text, NEVER);
+  assert.match(dataSourceForecastText('recorded'), /Live forecasts cover the 90-minute result only/);
+  assert.doesNotMatch(dataSourceForecastText('recorded'), /No live soccer forecast/);
+});
+
+test('a forecasted match shows its three probabilities, and its result once known', () => {
+  assert.equal(matchForecastNote('recorded', 'scheduled', forecast, 'Türkiye', 'Belgium'),
+    '90-minute forecast: Türkiye win 45.1% · Draw 27.0% · Belgium win 27.9%.');
+  assert.equal(matchForecastNote('recorded', 'final', { ...forecast, result: 'draw' }, 'Türkiye', 'Belgium'),
+    '90-minute forecast: Türkiye win 45.1% · Draw 27.0% · Belgium win 27.9%. 90-minute result: Draw.');
+});
+
+test('an unforecasted match says whether its forecast is still to come', () => {
+  assert.match(matchForecastNote('awaiting', 'scheduled', null, 'A', 'B'), /^Awaiting forecast/);
+  assert.match(matchForecastNote('recorded', 'scheduled', undefined, 'A', 'B'), /^Awaiting forecast/);
+  assert.equal(matchForecastNote('recorded', 'final', null, 'A', 'B'), 'No forecast was recorded for this match.');
+  assert.match(matchForecastNote('out_of_scope', 'scheduled', null, 'A', 'B'), /outside the live model/);
+  assert.match(matchForecastNote('no_live_store', 'scheduled', null, 'A', 'B'), /this data store records none/);
+  for (const state of ['recorded', 'awaiting', 'out_of_scope', 'no_live_store']) {
+    assert.doesNotMatch(matchForecastNote(state, 'scheduled', null, 'A', 'B'), /no validated model/i);
+  }
+});
+
+test('matches awaiting forecasts, out-of-scope competitions and stores without forecasts read differently', () => {
+  const texts = ['recorded', 'awaiting', 'out_of_scope', 'no_live_store'].map((s) => {
+    const b = forecastBanner(s, 'Premier League'); return b.title + ' ' + b.text;
+  });
+  assert.equal(new Set(texts).size, 4);
+  assert.match(texts[1], /No Premier League forecast is recorded yet/);
+  assert.match(texts[1], /each match is forecast before it starts/);
+  assert.match(texts[2], /did not pass its held-out test/);
+  assert.match(texts[3], /data store/);
+});
+
+test('"Last imported" describes the refresh that actually happened', () => {
+  const live = { check: { checked_at: '2026-11-09T01:30:54Z' }, refresh: { last_refresh_at: '2026-11-09T02:25:17Z', max_age_hours: 26, stale: false } };
+  assert.equal(importHint('Premier League', live, when),
+    'Latest Premier League scoreboard request. The live soccer job last checked this competition <2026-11-09T01:30:54Z>.');
+  assert.doesNotMatch(importHint('Premier League', live, when), NEVER);
+  const stale = { check: live.check, refresh: { last_refresh_at: '2026-11-07T20:00:00Z', max_age_hours: 26, stale: true } };
+  assert.match(importHint('Premier League', stale, when), /more than 26 h old.*new forecasts are refused/);
+  assert.equal(importHint('Premier League', { check: null, refresh: live.refresh }, when),
+    'Latest Premier League scoreboard request. No live soccer job has checked this competition in this data store.');
+  assert.equal(importHint('Premier League', null, when), 'Latest Premier League scoreboard request.');
+});
+
+test('an empty competition and a failed source are not described as "no predictions"', () => {
+  assert.equal(emptyCompetition('UEFA Euro qualifying', 41, '2026-11-09T02:26:53Z', when),
+    'No UEFA Euro qualifying matches are stored: ESPN listed none on the 41 days requested so far (latest request <2026-11-09T02:26:53Z>).');
+  assert.match(emptyCompetition('UEFA Euro qualifying', 0, null, when), /no day has been requested/);
+  assert.match(liveLoadProblem('503 Service Unavailable'), /could not be loaded \(503 Service Unavailable\).*not affected/);
+});
diff --git a/frontend/src/components/soccerStatus.ts b/frontend/src/components/soccerStatus.ts
new file mode 100644
index 0000000..5761157
--- /dev/null
+++ b/frontend/src/components/soccerStatus.ts
@@ -0,0 +1,81 @@
+// What the soccer screens say about forecasts and refreshes, derived only from what the API reports (backend
+// app/soccer.py forecast_state, /api/soccer/live). Pure text so it is unit-tested (soccerStatus.test.mjs): the page must
+// never say "no forecasts" beside recorded ones, and must tell apart forecasts recorded, matches still awaiting theirs,
+// a competition with nothing stored, and a source that failed or went stale.
+
+export type SoccerForecastState = 'recorded' | 'awaiting' | 'out_of_scope' | 'no_live_store';
+type Side = 'home' | 'draw' | 'away';
+interface MatchForecast { probabilities: Record<Side, number>; most_likely: Side; result: Side | null }
+interface LiveFacts {
+  check: { checked_at: string } | null;
+  refresh: { last_refresh_at: string | null; max_age_hours: number; stale: boolean };
+}
+
+const pct = (p: number) => `${(p * 100).toFixed(1)}%`;
+
+/** The notice above a competition's matches. `kind` picks the styling; `more` labels the expandable capability list. */
+export function forecastBanner(state: SoccerForecastState, competition: string): { kind: 'live' | 'awaiting' | 'none'; title: string; text: string; more: string } {
+  if (state === 'recorded') {
+    return { kind: 'live', title: 'Live soccer forecasts:', text: 'the 90-minute home/draw/away result only.', more: 'What else is not available' };
+  }
+  if (state === 'awaiting') {
+    return { kind: 'awaiting', title: `No ${competition} forecast is recorded yet:`,
+      text: 'the live 90-minute model covers this competition, and each match is forecast before it starts.', more: 'Details' };
+  }
+  if (state === 'out_of_scope') {
+    return { kind: 'none', title: `No live forecast for ${competition}:`,
+      text: 'it did not pass its held-out test, so only fixtures and results are shown.', more: 'Details' };
+  }
+  return { kind: 'none', title: 'No live soccer forecasts in this data store:', text: 'fixtures and results only.', more: 'Details' };
+}
+
+/** One match's forecast line: its recorded probabilities, or why there is none (yet). */
+export function matchForecastNote(state: SoccerForecastState, status: string, forecast: MatchForecast | null | undefined, home: string, away: string): string {
+  if (forecast) {
+    const names: Record<Side, string> = { home: `${home} win`, draw: 'Draw', away: `${away} win` };
+    const p = forecast.probabilities;
+    return `90-minute forecast: ${names.home} ${pct(p.home)} · Draw ${pct(p.draw)} · ${names.away} ${pct(p.away)}.`
+      + (forecast.result ? ` 90-minute result: ${names[forecast.result]}.` : '');
+  }
+  if (state === 'no_live_store') return 'No forecast: this data store records none.';
+  if (state === 'out_of_scope') return 'No forecast: this competition is outside the live model’s tested scope.';
+  if (status === 'scheduled') return 'Awaiting forecast: recorded before kickoff, once the earlier results it depends on are stored.';
+  return 'No forecast was recorded for this match.';
+}
+
+/** Hint under "Last imported": what refreshes this competition, and whether its data is too old for new forecasts. */
+export function importHint(competition: string, live: LiveFacts | null, when: (iso: string) => string): string {
+  const base = `Latest ${competition} scoreboard request`;
+  if (!live) return `${base}.`;
+  if (live.refresh.stale) {
+    return live.refresh.last_refresh_at
+      ? `${base}: more than ${live.refresh.max_age_hours} h old, so new forecasts are refused until it refreshes.`
+      : `No ${competition} scoreboard request is stored, so no forecast can be made.`;
+  }
+  return live.check
+    ? `${base}. The live soccer job last checked this competition ${when(live.check.checked_at)}.`
+    : `${base}. No live soccer job has checked this competition in this data store.`;
+}
+
+/** A competition with no stored match at all. */
+export function emptyCompetition(competition: string, fetchedDays: number, lastRefresh: string | null, when: (iso: string) => string): string {
+  if (fetchedDays > 0) {
+    return `No ${competition} matches are stored: ESPN listed none on the ${fetchedDays} day${fetchedDays === 1 ? '' : 's'} requested so far`
+      + `${lastRefresh ? ` (latest request ${when(lastRefresh)})` : ''}.`;
+  }
+  return `No ${competition} matches are stored, and no day has been requested for this competition yet.`;
+}
+
+/** The live forecast list could not be read: say so instead of silently showing fixtures only. */
+export function liveLoadProblem(error: string): string {
+  return `Live forecasts could not be loaded (${error}). Fixtures and results below are not affected.`;
+}
+
+/** The forecast sentence of the "Real data" note in the header. */
+export function dataSourceForecastText(state: SoccerForecastState): string {
+  const rest = ' No soccer odds or injury information is collected.';
+  if (state === 'recorded') return `Live forecasts cover the 90-minute result only.${rest}`;
+  if (state === 'awaiting') return `A live 90-minute forecast model covers this competition; none is recorded for it yet.${rest}`;
+  if (state === 'out_of_scope') return `No live forecast is made for this competition.${rest}`;
+  return `This data store records no live soccer forecast.${rest}`;
+}
