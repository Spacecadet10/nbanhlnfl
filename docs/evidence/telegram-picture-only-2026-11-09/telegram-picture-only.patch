+def ticket_caption(result):
+    """What the picture does not show, in a few plain lines (Telegram captions hold 1,024 characters): every ticket's legs
+    with the stored price, and what it pays at those prices. Never raises: it is shortened instead."""
+    tickets = result['resolved']
+    quoted = [p['quote_check']['retrieved_at'] for t in tickets for p in t['legs'] if (p.get('quote_check') or {}).get('price_now') is not None]
+
+    def build(labels):
+        lines = ['PROP51 · COMBINED PARLAY TICKETS · ' + result['date']]
+        for n, t in enumerate(tickets, 1):
+            legs = ' + '.join(p['pick_label'] + (f" ({p['quote_check']['price_now']:+d})" if (p.get('quote_check') or {}).get('price_now') is not None else '')
+                              for p in t['legs'])
+            try:
+                payout = (t.get('assessment') or ticket_assessment(t['legs']))['payout']
+            except Exception:
+                payout = None
+            lines.append(f"#{n}" + (f" {t['label']}" if labels else '') + f": {legs}" + (f" — pays about ×{payout:.2f}" if payout else '')
+                         + (f" — ${t['stake_usd']:.2f}" if t.get('stake_usd') is not None else ''))
+        lines.append('Each numbered ticket is ONE parlay with all its legs.' + (
+            ' Prices: stored DraftKings quotes, ' + _parse(max(quoted)).astimezone(TORONTO).strftime('%I:%M %p %Z') + '; confirm before betting.' if quoted else ''))
+        if len(tickets) > CARD_TICKETS:
+            lines.append(f"The picture shows tickets 1-{CARD_TICKETS}; the others are listed here.")
+        return '\n'.join(lines)
+    caption = build(True)
+    if len(caption) > 1024:
+        caption = build(False)
+    return caption if len(caption) <= 1024 else caption[:1021] + '...'
+
