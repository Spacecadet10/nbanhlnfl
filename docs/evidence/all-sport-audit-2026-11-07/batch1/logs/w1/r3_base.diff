+        "UNION ALL SELECT NULL, r.raw_id, r.first_retrieved_at, r.source FROM raw_responses r "
+        "WHERE r.source IN (?, ?, ?, ?) AND NOT EXISTS (SELECT 1 FROM raw_fetches f WHERE f.raw_id = r.raw_id) "
+        "ORDER BY 3, 1, 2", sources * 2).fetchall()
