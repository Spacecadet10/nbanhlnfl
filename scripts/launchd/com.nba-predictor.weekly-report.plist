<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Weekly plain-language page (scripts/weekly_report.py): Monday 09:00 local. Read-only; writes data/reports/weekly-YYYY-MM-DD.md only.
	     NOT installed. The recorder review time and reviewed recorder sha256 live only in scripts/weekly_report_review.json. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nba-predictor-sprint1/data</string>
		<key>NBA_RELEASE_GUARD</key>
		<string>1</string>
		<key>NBA_RELEASE_ROOT</key>
		<string>/Users/andry/nba-predictor-delivery</string>
		<key>OMP_NUM_THREADS</key>
		<string>2</string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.weekly-report</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/andry/nba-predictor-delivery/backend/.venv/bin/python</string>
		<string>/Users/andry/nba-predictor-delivery/scripts/weekly_report.py</string>
		<string>--ledger</string>
		<string>/Users/andry/Desktop/nba-predictor-sprint1/.telegram-delivery.sqlite</string>
		<string>--review-config</string>
		<string>/Users/andry/nba-predictor-delivery/scripts/weekly_report_review.json</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nba-predictor-sprint1/data/weekly-report.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nba-predictor-sprint1/data/weekly-report.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/backend</string>
</dict>
</plist>
