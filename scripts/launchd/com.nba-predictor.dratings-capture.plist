<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DRatings on paper (app/dratings_capture.py): every 2 minutes; a request only when a new app forecast exists. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nba-predictor-sprint1/data</string>
		<key>NBA_RELEASE_GUARD</key>
		<string>1</string>
		<key>NBA_RELEASE_ROOT</key>
		<string>/Users/andry/nba-predictor-delivery</string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.dratings-capture</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/andry/nba-predictor-delivery/backend/.venv/bin/python</string>
		<string>-m</string>
		<string>app.dratings_capture</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nba-predictor-sprint1/data/dratings-capture.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nba-predictor-sprint1/data/dratings-capture.log</string>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/backend</string>
</dict>
</plist>
