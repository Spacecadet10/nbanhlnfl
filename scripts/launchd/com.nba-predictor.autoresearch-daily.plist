<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Scheduled autoresearch EVALUATION of all five sports (nba nhl ncaab nfl soccer), four local-time slots: 04:00, 05:00, 06:00 and 07:30.
	     scripts/autoresearch_daily.sh runs guarded, resumable chunks (`prepare.py daily` with the sport name; no item or trial cap, a soft
	     15 minutes per chunk with a 30-minute stuck-process margin) in round-robin passes over the sports until none has work left or the
	     run window ends (170 minutes, and at 08:55 local at the latest so the heavy lock is free for adaptive-train's 09:30 start).
	     `daily` never starts an agent and never spends money: it only re-scores existing commits.
	     The later slots are same-day retries: a sport that is `refused` (game window or forecasting guard) or `pending` (work remains,
	     progress stored) is run again, there is no attempt cap; evaluated (complete), no_candidates and failed sports print
	     outcome=done_today. The slots sit before adaptive-train's 09:30 heavy-lock run, where the games-in-progress guard is open
	     (a 14-day simulation: a 04:00-07:00 start is open on 12-14 of 14 days, late-morning and afternoon starts almost never); app.learning_run still decides per chunk.
	     NOT installed. Opt-in: the wrapper refuses (exit 78) unless ~/autoresearch-sports/SCHEDULE_DAILY_ENABLED exists.
	     NBA_DATA_DIR here is only the guard's lock, log and read-only schedule lookup; prepare.py points the evaluator at its own
	     read-only snapshot. Log: data/research/autoresearch-daily.log; the status page reads daily-state.tsv in ~/autoresearch-sports. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>LEARNING_PYTHON</key>
		<string>/Users/andry/nba-predictor-live/backend/.venv/bin/python</string>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nbanhlnfl/data</string>
		<key>OMP_NUM_THREADS</key>
		<string>2</string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.autoresearch-daily</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>15</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/andry/nba-predictor-delivery/scripts/autoresearch_daily.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>4</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>5</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>6</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>7</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/research/autoresearch-daily.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/research/autoresearch-daily.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/backend</string>
</dict>
</plist>
