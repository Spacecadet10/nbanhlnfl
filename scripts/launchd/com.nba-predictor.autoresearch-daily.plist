<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Scheduled autoresearch EVALUATION of all five sports (nba nhl ncaab nfl soccer), three local-time slots: 06:00, 11:10 and 13:10.
	     scripts/autoresearch_daily.sh runs one guarded step per sport (`prepare.py daily` with the sport name, 3 trials / 12 minutes per sport,
	     100 minutes in all). `daily` never starts an agent and never spends money: it only re-scores existing commits.
	     The 11:10 and 13:10 slots are same-day retries: only a sport that was `refused` (game window or forecasting guard) or skipped for the
	     total wall cap is run again; evaluated, no_candidates and failed sports print outcome=done_today, and at most 3 attempts per sport per
	     local day. They sit between adaptive-train's 09:30 and 15:30 heavy-lock runs; app.learning_run still decides per sport.
	     NOT installed. Opt-in: the wrapper refuses (exit 78) unless ~/autoresearch-sports/SCHEDULE_DAILY_ENABLED exists.
	     NBA_DATA_DIR here is only the guard's lock, log and read-only schedule lookup; prepare.py points the evaluator at its own
	     read-only snapshot. Log: data/research/autoresearch-daily.log; the status page reads daily-state.tsv in ~/autoresearch-sports. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>LEARNING_PYTHON</key>
		<string>/Users/andry/nba-predictor-live/backend/.venv/bin/python</string>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nbanhlnfl/data</string>
		<key>OMP_NUM_THREADS</key>
		<string>2</string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.autoresearch-daily</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>15</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/andry/nba-predictor-delivery/scripts/autoresearch_daily.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>6</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>11</integer>
			<key>Minute</key>
			<integer>10</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>10</integer>
		</dict>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/research/autoresearch-daily.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/research/autoresearch-daily.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/backend</string>
</dict>
</plist>
