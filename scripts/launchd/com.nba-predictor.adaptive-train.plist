<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- adaptive-v1 scheduled training (docs/ADAPTIVE_SYSTEM.md §7) run with the live release's Python and code
     (/Users/andry/nba-predictor-live, release guard on, as the odds job). That environment has no torch / tensorflow, so the
     deep members are recorded 'skipped' (never counted as fitted) and the combiner uses the available members. Switching the
     job to the deep environment (/Users/andry/nba-predictor-deep Python with PYTHONPATH=/Users/andry/nba-predictor-live/backend)
     is a separate decision, taken only after a verified bounded deep run. The command takes the store's job lock only to snapshot and to publish; the training reads
     the snapshot under its own lock, so the odds/forecast cycles keep running. Due-only and idempotent. Install only with a
     release move.
     Order per sport (docs/ADAPTIVE_SYSTEM.md §14): `training-inputs` collects (results, NHL shots and player boxes, NBA boxes)
     and checks; only when it passes, `adaptive-train` (weekly) then `adaptive-train` with the daily cadence. A run that is not ready
     exits 1 (job_runs 'training_inputs' failed; adaptive-train 'deferred'); the 15:30 run is the retry (anything already
     trained is not due and is skipped). Overlap: the store lock for collection, the per-sport training lock for training, and the machine-wide heavy lock
     (<NBA_DATA_DIR>/.learning-heavy.lock) through the delivery release's app.learning_run, shared with the deep runs and the
     autoresearch jobs: a second heavy job is refused (exit 75), never queued. No game-window deferral (empty defer-sports list), so
     the schedule is unchanged; wall cap 300 min (first scheduled run: 105 min), memory cap 8 GB, effective nice 10. -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nbanhlnfl/data</string>
		<key>NBA_PLAYER_BOX_REFRESH</key>
		<string>1</string>
		<key>NBA_RELEASE_GUARD</key>
		<string>1</string>
		<key>NBA_RELEASE_ROOT</key>
		<string>/Users/andry/nba-predictor-live</string>
		<key>NHL_PLAYER_BOX_REFRESH</key>
		<string>1</string>
		<key>OMP_NUM_THREADS</key>
		<string>4</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.adaptive-train</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/Users/andry/nba-predictor-delivery/backend/.venv/bin/python</string>
		<string>-m</string>
		<string>app.learning_run</string>
		<string>--name</string>
		<string>adaptive-train</string>
		<string>--max-minutes</string>
		<string>300</string>
		<string>--max-rss-gb</string>
		<string>8</string>
		<string>--nice</string>
		<string>0</string>
		<string>--threads</string>
		<string>4</string>
		<string>--defer-sports</string>
		<string></string>
		<string>--</string>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>cd /Users/andry/nba-predictor-live/backend &amp;&amp; PY=/Users/andry/nba-predictor-live/backend/.venv/bin/python; rc=0; for s in nhl nba; do if $PY -m app.cli --sport $s training-inputs; then $PY -m app.cli --sport $s adaptive-train || rc=1; $PY -m app.cli --sport $s adaptive-train --cadence daily || rc=1; else rc=1; fi; done; exit $rc</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/adaptive-train-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/adaptive-train-launchd.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>15</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/backend</string>
</dict>
</plist>
