<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- adaptive-v1 scheduled training (docs/ADAPTIVE_SYSTEM.md sections 7 and 14), as installed: the LIVE release checkout's code and venv
     (the NBA/NHL fits carry that code's definition), under the machine-wide learning guard (app.learning_run, delivery checkout).
     Order per sport: `training-inputs` collects (results, NHL shots and player boxes, NBA boxes) and checks; on exit 0 or 3 the weekly,
     then the daily-cadence `adaptive-train`; any other code means training must wait (exit 1; the 15:30 run is the retry). Exit 3 =
     trained, but a required collection step failed: the whole job then ends 3, never 0 (owner, Nov 25 2026). Due-only, idempotent. -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nbanhlnfl/data</string>
		<key>NBA_PLAYER_BOX_REFRESH</key>
		<string>1</string>
		<key>NBA_RELEASE_GUARD</key>
		<string>1</string>
		<key>NBA_RELEASE_ROOT</key>
		<string>/Users/andry/nba-predictor-live</string>
		<key>NHL_PLAYER_BOX_REFRESH</key>
		<string>1</string>
		<key>OMP_NUM_THREADS</key>
		<string>4</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.adaptive-train</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/Users/andry/nba-predictor-delivery/backend/.venv/bin/python</string>
		<string>-m</string>
		<string>app.learning_run</string>
		<string>--name</string>
		<string>adaptive-train</string>
		<string>--max-minutes</string>
		<string>300</string>
		<string>--max-rss-gb</string>
		<string>8</string>
		<string>--nice</string>
		<string>0</string>
		<string>--threads</string>
		<string>4</string>
		<string>--defer-sports</string>
		<string></string>
		<string>--</string>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>cd /Users/andry/nba-predictor-live/backend &amp;&amp; PY=/Users/andry/nba-predictor-live/backend/.venv/bin/python; rc=0; partial=0; for s in nhl nba; do $PY -m app.cli --sport $s training-inputs; t=$?; if [ $t -eq 0 ] || [ $t -eq 3 ]; then [ $t -eq 0 ] || partial=3; $PY -m app.cli --sport $s adaptive-train || rc=1; $PY -m app.cli --sport $s adaptive-train --cadence daily || rc=1; else rc=1; fi; done; [ $rc -ne 0 ] || rc=$partial; exit $rc</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/adaptive-train-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/adaptive-train-launchd.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>15</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/backend</string>
</dict>
</plist>
