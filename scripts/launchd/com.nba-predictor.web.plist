<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Everything from the delivery release API; research and training-run pages from the forecast jobs' release API
         (their research definitions are bound to that code). docs/evidence/webapp-switch-prep-2026-11-09/PLAN.md -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>API_PROXY_TARGET</key>
		<string>http://127.0.0.1:8101</string>
		<key>API_PROXY_TARGET_RESEARCH</key>
		<string>http://127.0.0.1:8100</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.nba-predictor.web</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/andry/nba-predictor-delivery/frontend/node_modules/vite/bin/vite.js</string>
		<string>preview</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>4173</string>
		<string>--strictPort</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/web-release.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/web-release.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-delivery/frontend</string>
</dict>
</plist>
