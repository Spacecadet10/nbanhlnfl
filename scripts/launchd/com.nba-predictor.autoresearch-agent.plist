<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Scheduled autoresearch GENERATION (PAID): requires owner budget file ~/autoresearch-sports/AGENT_BUDGET.json. Weekly, Monday 13:00 local.
	     NOT installed. scripts/autoresearch_agent_scheduled.sh refuses (exit 78) unless the budget file validates and the period's recorded spend leaves room; it
	     passes max-usd, model and max-trials from that file. Do not install without a new owner budget.
	     The wrapper runs the command through app.learning_run (one heavy job per machine, nice, wall-clock and memory caps, no start within
	     2.5 h of an NBA/NHL/NCAAB tip-off) and writes data/research/learning-runs.jsonl. NBA_DATA_DIR here is only the guard's lock, log and
	     read-only schedule lookup; prepare.py points the evaluator at its own read-only snapshot. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>LEARNING_PYTHON</key>
		<string>/Users/andry/nba-predictor-live/backend/.venv/bin/python</string>
		<key>NBA_DATA_DIR</key>
		<string>/Users/andry/Desktop/nbanhlnfl/data</string>
		<key>OMP_NUM_THREADS</key>
		<string>2</string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.nba-predictor.autoresearch-agent</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>15</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/andry/nba-predictor-live/scripts/autoresearch_agent_scheduled.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>13</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/research/autoresearch-agent.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andry/Desktop/nbanhlnfl/data/research/autoresearch-agent.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/andry/nba-predictor-live/backend</string>
</dict>
</plist>
